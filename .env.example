# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key, used server-side only by /api/claude (+ upload)
ANTHROPIC_API_KEY=

# Cutout microservice — transparent-background on Hugging Face Spaces (or local)
# Local:  http://127.0.0.1:7860
# Space:  https://<user>-<space>.hf.space
CUTOUT_SERVICE_URL=http://127.0.0.1:7860
# Optional shared secret (must match CUTOUT_SERVICE_KEY on the Python service)
CUTOUT_SERVICE_KEY=dev-secret

# Optional public site URL (for OG metadataBase)
NEXT_PUBLIC_SITE_URL=https://harbi.eu

# Optional Umami analytics (public pages only)
# Example script URL: https://analytics.example.com/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional comma-separated domains for Umami data-domains
NEXT_PUBLIC_UMAMI_DOMAINS=
