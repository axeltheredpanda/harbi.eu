# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — needed for RSS news sync (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key, used server-side only by /api/claude (+ upload)
ANTHROPIC_API_KEY=

# Voyage AI (embeddings for Jarvis notes) — free tier key from voyageai.com
VOYAGE_API_KEY=

# Shared secret for /api/news/sync — any long random string (openssl rand -base64 32).
# Same value in: Vercel env + GitHub Actions secret (Settings → Secrets → CRON_SECRET).
# Free auto-sync every 30m via .github/workflows/news-sync.yml. Drawer: Ctrl+Shift+Y.
# Also authorizes /api/jarvis/briefing cron.
CRON_SECRET=

# Optional public site URL (for OG metadataBase)
NEXT_PUBLIC_SITE_URL=https://harbi.eu

