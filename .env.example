# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key, used server-side only by /api/claude (+ upload)
ANTHROPIC_API_KEY=

# rembg microservice (services/rembg) — used by /api/remove-bg
# Example: https://your-rembg.up.railway.app
REMBG_SERVICE_URL=
# Optional shared secret; must match REMBG_SERVICE_KEY on the Python service
REMBG_SERVICE_KEY=

# Optional public site URL (for OG metadataBase)
NEXT_PUBLIC_SITE_URL=https://harbi.eu

# Optional Umami analytics (public pages only)
# Example script URL: https://analytics.example.com/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional comma-separated domains for Umami data-domains
NEXT_PUBLIC_UMAMI_DOMAINS=
